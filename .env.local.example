# Environment variables for AMCON Castings Next.js Project
# Copy this file to .env.local and update values as needed

# API Configuration (if needed for backend integration)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Contact Email Configuration (for form submissions)
# NEXT_PUBLIC_CONTACT_EMAIL=info@amconcastings.com

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# WhatsApp Configuration
# NEXT_PUBLIC_WHATSAPP_NUMBER=+1555123456
